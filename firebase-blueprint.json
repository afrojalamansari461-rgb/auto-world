{
  "entities": {
    "UserListing": {
      "title": "UserListing",
      "description": "A vehicle listing posted by an authenticated user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "make": { "type": "string" },
        "model": { "type": "string" },
        "year": { "type": "string" },
        "price": { "type": "integer" },
        "condition": { "type": "integer" },
        "mileage": { "type": "string" },
        "fuelType": { "type": "string" },
        "description": { "type": "string" },
        "negotiable": { "type": "string" },
        "sellerName": { "type": "string" },
        "sellerEmail": { "type": "string" },
        "sellerPhone": { "type": "string" },
        "location": { "type": "string" },
        "features": {
          "type": "array",
          "items": { "type": "string" }
        },
        "transmission": { "type": "string" },
        "engineSize": { "type": "string" },
        "featured": { "type": "boolean" },
        "urgent": { "type": "boolean" },
        "photos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "src": { "type": "string" },
              "alt": { "type": "string" }
            }
          }
        },
        "datePosted": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "sold", "pending", "hidden"] },
        "userId": { "type": "string" }
      },
      "required": ["id", "title", "type", "make", "model", "year", "price", "sellerName", "sellerEmail", "sellerPhone", "location", "status", "userId"]
    },
    "UserPartListing": {
      "title": "UserPartListing",
      "description": "An automotive performance part or upgrade item posted by an authenticated user or merchant",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "rarity": { "type": "string", "enum": ["Common", "Uncommon", "Rare", "Epic", "Legendary"] },
        "condition": { "type": "integer" },
        "brand": { "type": "string" },
        "price": { "type": "integer" },
        "compatibleVehicles": { "type": "string" },
        "description": { "type": "string" },
        "negotiable": { "type": "string" },
        "sellerName": { "type": "string" },
        "sellerEmail": { "type": "string" },
        "sellerPhone": { "type": "string" },
        "location": { "type": "string" },
        "partNumber": { "type": "string" },
        "warranty": { "type": "string" },
        "featured": { "type": "boolean" },
        "urgent": { "type": "boolean" },
        "verified": { "type": "boolean" },
        "photos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "src": { "type": "string" },
              "alt": { "type": "string" }
            }
          }
        },
        "datePosted": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "sold", "pending", "hidden"] },
        "userId": { "type": "string" }
      },
      "required": ["id", "title", "category", "rarity", "condition", "brand", "price", "compatibleVehicles", "sellerName", "sellerEmail", "sellerPhone", "location", "status", "userId"]
    },
    "Message": {
      "title": "Message",
      "description": "A contact submission message",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["name", "email", "subject", "message", "date"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "User premium tier subscription state",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "plan": { "type": "string" },
        "price": { "type": "integer" },
        "period": { "type": "string", "enum": ["monthly", "yearly"] },
        "startDate": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "expired"] }
      },
      "required": ["userId", "plan", "price", "period", "startDate", "status"]
    },
    "BuyerPass": {
      "title": "BuyerPass",
      "description": "Indicates that a signed-in buyer has paid the 1rs activation fee to unlock full listings access",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "paid": { "type": "boolean" },
        "date": { "type": "string" }
      },
      "required": ["userId", "paid", "date"]
    },
    "UserFavorites": {
      "title": "UserFavorites",
      "description": "User saved/favorited list of vehicle, listing, and motorsport hardware part IDs",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "favoriteIds": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "favoritePartIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "lastUpdated": { "type": "string" }
      },
      "required": ["userId", "favoriteIds"]
    },
    "UserFeedback": {
      "title": "UserFeedback",
      "description": "User submitted feedback about WCAG compliance, bugs, or general recommendations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "category": { "type": "string", "enum": ["bug_report", "suggestion", "question", "praise"] },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "timestamp": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "archived", "resolved"] }
      },
      "required": ["id", "text", "category", "timestamp", "status"]
    },
    "LoanLead": {
      "title": "LoanLead",
      "description": "Captured buyer loan application details for bank and insurance financing referrals",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "city": { "type": "string" },
        "monthlyIncome": { "type": "string" },
        "vehiclePrice": { "type": "integer" },
        "downPayment": { "type": "integer" },
        "loanAmount": { "type": "integer" },
        "tenureYears": { "type": "integer" },
        "interestRate": { "type": "number" },
        "monthlyEMI": { "type": "integer" },
        "vehicleTitle": { "type": "string" },
        "vehicleId": { "type": "string" },
        "createdAt": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["fullName", "phone", "city", "monthlyIncome", "vehiclePrice", "downPayment", "loanAmount", "tenureYears", "monthlyEMI"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered platform user identity and assigned role",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["Owner", "Super Admin", "Inventory Manager", "Sales & Leads Specialist", "Support Agent", "Content Moderator", "Finance Specialist", "User"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "string" },
        "lastLogin": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "users": {
      "schema": "UserProfile",
      "description": "Live directory of registered platform users and assigned staff access roles"
    },
    "listings": {
      "schema": "UserListing",
      "description": "A global collection containing all pre-owned vehicle listing briefs posted by verified users"
    },
    "parts": {
      "schema": "UserPartListing",
      "description": "Global collection containing all curated automotive performance parts and aftermarket upgrades"
    },
    "messages": {
      "schema": "Message",
      "description": "Contact form help and support tickets submitted by visitors"
    },
    "subscriptions": {
      "schema": "Subscription",
      "description": "User subscriptions maps by userId key to restrict access to pro features and dashboards"
    },
    "buyer_passes": {
      "schema": "BuyerPass",
      "description": "Locks or unlocks complete vehicle spec sheets matching structural paywalls"
    },
    "user_favorites": {
      "schema": "UserFavorites",
      "description": "Store list of saved/bookmarked vehicle IDs synchronized to user accounts"
    },
    "feedbacks": {
      "schema": "UserFeedback",
      "description": "Collection tracking user feedback submissions"
    },
    "userFeedback": {
      "schema": "UserFeedback",
      "description": "User feedback collection tracking submissions"
    },
    "loanLeads": {
      "schema": "LoanLead",
      "description": "Collection capturing buyer instant loan application leads for bank financing referrals"
    }
  }
}
